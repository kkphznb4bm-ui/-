{
  "firestore": { "rules": "firestore.rules" },
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules", "**/.*", "server/**", "data/**", "node_modules/**", "Dockerfile", "package.json", "README.md", "LICENSE"],
