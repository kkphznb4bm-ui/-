{
  "mcpServers": {
    "ruflo": {
      "command": "npx",
      "args": ["-y", "ruflo@3.77.1", "mcp", "start"]
    },
    "ffmpeg": {
      "command": "npx",
      "args": ["-y", "ffmpeg-mcp"]
    },
    "remotion": {
      "command": "npx",
      "args": ["-y", "@remotion/mcp@latest"]
    },
    "fal-ai": {
      "command": "npx",
      "args": ["-y", "fal-ai-mcp@0.2.1"],
      "env": {
        "FAL_KEY": "${FAL_KEY}"
      }
    }
  }
}
